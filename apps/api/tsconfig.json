{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@trending-market/shared/*": ["../../packages/shared/src/*"]
    },

    "lib": ["ES2022"],
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "target": "esnext",
    "types": ["node"],
    "composite": true
  },
  "references": [{ "path": "../../packages/shared" }],
  "include": ["src/**/*.ts", "src/**/*.json"]
}
